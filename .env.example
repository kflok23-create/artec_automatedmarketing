# HERMES environment variables — §11. Every name here is required at boot unless noted.
# Secrets are set in the Railway dashboard (or a hand-written local .env), NEVER committed.

# Core service
DATABASE_URL=
PORT=8000
HERMES_API_TOKEN=
PUBLIC_BASE_URL=
ENVIRONMENT=production
LOG_LEVEL=INFO

# Anthropic — one model for learn, ideate, copy, toolbox routing
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# fal.ai — GENERATE / EDIT / ENHANCE / video
FAL_KEY=

# Google Drive — service account JSON as a RAW JSON STRING (not a file path)
# GOOGLE_SHARED_DRIVE_ID is OPTIONAL: leave empty for My Drive mode (personal Gmail; bank
# folder shared with the service account as Editor). Set only for a Workspace Shared Drive.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SHARED_DRIVE_ID=

# Upload-Post — five social surfaces
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=

# Brevo — consumer list only
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=
BREVO_TEMPLATE_ID=

# Telegram — the weekly gate
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stripe (SG)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Billplz (MY)
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_XSIGNATURE_KEY=
